# Copiez ce fichier en .env.local pour le développement, et renseignez les
# mêmes variables dans Vercel (Project → Settings → Environment Variables).
# Aucune de ces valeurs n'est secrète, mais ne commitez jamais .env.local.

# Domaine définitif, sans barre oblique finale (URL canoniques, sitemap, Open Graph).
# Sur Vercel, si elle est absente, le domaine de production Vercel est utilisé.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Adresse e-mail publique affichée sur la page Contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Search Console : valeur « content » de la balise meta de vérification.
GOOGLE_SITE_VERIFICATION=

# Formulaire de contact (facultatif) — variables PRIVÉES, à définir uniquement dans Vercel.
# Sans elles, la page Contact affiche seulement NEXT_PUBLIC_CONTACT_EMAIL.
# Clé API : https://resend.com (offre gratuite). Expéditeur : domaine vérifié chez Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Publicité — laisser vide tant qu'aucune régie et aucun outil de consentement ne sont en place.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_CLIENT_ID=

# Tableau de bord d'administration (/keystatic) — connexion GitHub en production.
# Ces valeurs sont générées automatiquement lors de la création de l'application
# GitHub (voir « Tableau de bord » dans le README). Les trois premières sont PRIVÉES.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Facultatif : dépôt GitHub du site (par défaut Hassan-ibbakh/Morocco-Vibe).
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Facultatif, en local uniquement : « github » pour tester la connexion GitHub avec npm run dev.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# Newsletter (facultatif) — Brevo, avec double confirmation. Variables PRIVÉES, à définir dans Vercel.
# Sans elles, le formulaire d'inscription n'apparaît pas.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
